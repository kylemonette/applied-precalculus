<shortdescription>
A short description.
</shortdescription>
<latex-image label="3_1_1_fig">
\begin{tikzpicture}[scale=0.8]
\begin{axis}[grid=both,
xmin=-4.5,xmax=3.5,
ymin=-5.5,ymax=5.5,
xtick={-4,...,3},
ytick={-5,...,5},
minor tick={},
xlabel=\(x\), ylabel=\(y\),
y post scale = 1.3,
