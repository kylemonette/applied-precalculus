
DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl",
"parserPopUp.pl"
);

# DropDown that shows a blank line (not the list of choices) before "Activate".
# Same arguments as DropDown; any options given override the default.
sub DropDownBlank {
  my ($choices, $answer, %options) = @_;
  return DropDown($choices, $answer, showInStatic => 0, %options);
}

TEXT(beginproblem());
Context('Numeric');
$var_indp = DropDownBlank(["t", "V", "g"], "t");
$var_dep = DropDownBlank(["t", "V", "g"], "V");
$units_indp = DropDownBlank(["dollars", "years", "dollars/year"], "years");
$units_dep = DropDownBlank(["dollars", "years", "dollars/year"], "dollars");

############################################################
# Body
############################################################

BEGIN_PGML
The value of a car, [`V`], in dollars, is a function of the number of years, [`t`], since it was purchased; that is, [`V=g(t)`].

The independent variable is [_____]{$var_indp} with units [_____]{$units_indp}.

The dependent variable is [_____]{$var_dep} with units [_____]{$units_dep}.

END_PGML


BEGIN_PGML_SOLUTION
The independent variable is [`t`] and has units of years. The dependent variable is [`V`] and has units of dollars.
END_PGML_SOLUTION

ENDDOCUMENT();