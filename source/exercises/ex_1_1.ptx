<exercise xml:id="exercise_1_1_8">
<introduction>
<p>
Let <m>f(x)=4-3x</m>. Evaluate and simplify if possible:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(3b)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-9b+4</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(b+1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-3b+1</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(b+3)-f(3)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-3b</m>
    </p>
</solution>
</task>
</exercise>






<exercise xml:id="exercise_1_1_9">
<introduction>
<p>
Let <m>g(x)=3x-x^2</m>. Evaluate:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>g(2)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>2</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g(-2)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-10</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g(\sqrt{2})</m>
        </p>
    </statement>
<solution>
    <p>
        <m>3\sqrt{2}-2</m>
    </p>
</solution>
</task>
</exercise>







<exercise xml:id="exercise_1_1_10">
<introduction>
<p>
Let <m>g(x)=x^2+3</m>. Evaluate and simplify if possible:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>g(h-1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>h^2-2h+4</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g(h+1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>h^2+2h+4</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g(b+1)-g(1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>b^2+2b</m>
    </p>
</solution>
</task>
</exercise>








<exercise xml:id="exercise_1_1_11">
<introduction>
<p>
Let <m>\displaystyle f(x)=\frac{1}{x+1}</m>. Evaluate. If the value is undefined, say so.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(0)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>1</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(-1)</m>
        </p>
    </statement>
<solution>
    <p>
        undefined
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(-2)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-1</m>
    </p>
</solution>
</task>
</exercise>








<exercise xml:id="exercise_1_1_12">
<introduction>
<p>
Let <m>\displaystyle f(x)=\frac{3}{x+2}</m>. Evaluate and simplify if possible.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(h-1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{3}{h+1}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(h+1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{3}{h+3}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(b)-4f(1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{3}{b+2}-4</m>
    </p>
</solution>
</task>
</exercise>





<exercise xml:id="exercise_1_1_13">
<introduction>
<p>
Let <m>f(t)=t^2+\frac{1}{t}</m>. Evaluate and simplify if possible.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(2)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{9}{2}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(h+1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>h^2+2h+1+\frac{1}{h+1}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(h+1) - f(2)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>h^2+2h+\frac{1}{h+1}-\frac{7}{2}</m>
    </p>
</solution>
</task>
</exercise>






<exercise xml:id="exercise_1_1_14">
<introduction>
<p>
Let <m>g(x)=2x^2+\frac{3}{2}x</m> and <m>f(x)=x+3</m>. Evaluate and simplify if possible.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(2)+g(1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{17}{2}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g(1)+2f(x+1)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>2x+\frac{23}{2}</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(2x)-g(4+x)</m>
        </p>
    </statement>
<solution>
    <p>
        <m>-2x^2-\frac{31}{2}x-35</m>
    </p>
</solution>
</task>
</exercise>






<exercise xml:id="exercise_1_1_15">
<introduction>
<p>
A URI student tutors for MTH 103. The cost of each session in terms of hours, <m>t</m>, is given by the function <m>c(t)=10t+15</m>.
</p>
</introduction>

<task>
    <statement>
        <p>
        What is the cost of a 3 hour session?
        </p>
    </statement>
<solution>
    <p>
        <m>\$45</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        If <m>c(t)=\$60</m>, how many hours was the session?
        </p>
    </statement>
<solution>
    <p>
        <m>4.5</m> hours
    </p>
</solution>
</task>
</exercise>









<exercise xml:id="exercise_1_1_16">
<introduction>
<p>
The value of a car, <m>V</m>, in dollars, <m>t</m> years after purchase is given by the function <m>V=g(t)</m>, where <m>g(t)=16500-1500t</m>.
</p>
</introduction>

<task>
    <statement>
        <p>
        What is the value of the car at the time of purchase?
        </p>
    </statement>
<solution>
    <p>
        <m>\$16500</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        What is the value of the car <m>5</m> years after purchase?
        </p>
    </statement>
<solution>
    <p>
        <m>\$9000</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        After how many years is the car worth nothing?
        </p>
    </statement>
<solution>
    <p>
        <m>11</m> years
    </p>
</solution>
</task>
</exercise>







<exercise xml:id="exercise_1_1_17">
<introduction>
<!-- \footnote{https://www.weather.gov/safety/lightning-science-thunder, accessed: 6/26/20}. -->
<p>
Since you see lightning immediately and it takes the sound of thunder about 5 seconds to travel a mile, you can calculate the distance between you and the lightning. Count the number of seconds, <m>S</m>, between the flash of lightning and the sound of thunder. Then the distance, <m>D</m>, in miles, between you and the lightning is given by the function:
<md>
D=\frac{S}{5}
</md>
</p>
</introduction>

<task>
    <statement>
        <p>
        Identify the independent and the dependent variable.
        </p>
    </statement>
<solution>
    <p>
        <m>S</m> is the independent variable; <m>D</m> is the dependent variable
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        How far is the lightning if you counted 4 seconds between the flash and the thunder?
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{4}{5}</m> of a mile
    </p>
</solution>
</task>
</exercise>







<exercise xml:id="exercise_1_1_18">
<statement>
<p>
The cost of a medium pizza is <m>\$10</m> plus <m>\$1.75</m> per topping. Write a function <m>f(x)</m> to describe the cost of a medium pizza with <m>x</m> number of toppings.
</p>
</statement>

<solution>
<p>
<m>f(x)=1.75x+10</m>
</p>
</solution>
</exercise>







<exercise xml:id="exercise_1_1_19">
<introduction>
<p>
Find a formula for a function <m>h(x)</m> for each of the following scenarios:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>h</m> multiplies the input by 7 then adds <m>5</m> to the result.
        </p>
    </statement>
<solution>
    <p>
        <m>7x+5</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>h</m> adds <m>5</m> to the input and then multiplies the result by 7.
        </p>
    </statement>
<solution>
    <p>
        <m>7(x+5)</m>
    </p>
</solution>
</task>
</exercise>






<exercise xml:id="exercise_1_1_20">
<introduction>
<p>
Find a formula for a function <m>f(x)</m> for each of the following scenarios:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f</m> takes the square of the input, multiplies the result by 5, then subtracts 8.
        </p>
    </statement>
<solution>
    <p>
        <m>5x^2-8</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f</m> multiplies the input by 5, takes the square of the result, then subtracts 8.
        </p>
    </statement>
<solution>
    <p>
        <m>(5x)^2-8 = 25x^2-8</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f</m> subtracts 8 from the input, takes the square of the result, then multiplies by 5.
        </p>
    </statement>
<solution>
    <p>
        <m>5(x-8)^2</m>
    </p>
</solution>
</task>
</exercise>










<exercise xml:id="exercise_1_1_21">
<introduction>
<p>
Find a formula for a function <m>g(x)</m> for each of the following scenarios:
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>g</m> takes the input, divides it by 3, then adds this to the square root of the input times 4.
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{x}{3} + \sqrt{x}\cdot 4</m>
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>g</m> takes the reciprocal of the square root of the input, adds <m>1</m> to this, and then adds the input squared.
        </p>
    </statement>
<solution>
    <p>
        <m>\frac{1}{\sqrt{x}}+1+x^2</m>
    </p>
</solution>
</task>
</exercise>





<exercise xml:id="exercise_1_1_22">
<introduction>
<p>
Find the domain of each of the following functions.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>\displaystyle f(x)=x-1</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers or <m>(-\infty,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>\displaystyle f(x)=\frac{1}{x-1}</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers <m>x\neq1</m> or <m>(-\infty,1)\cup(1,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>\displaystyle f(x)=\frac{2}{x^2-4}</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers <m>x\neq-2</m>, <m>x\neq2</m> or <m>(-\infty,-2)\cup(-2,2)\cup(2,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>\displaystyle f(x)=\sqrt{x}</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers <m>x\geq0</m> or <m>[0,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>\displaystyle f(x)=x^2-4</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers or <m>(-\infty,\infty)</m> in interval notation
    </p>
</solution>
</task>
</exercise>







<exercise xml:id="exercise_1_1_23">
<introduction>
<p>
Find the domain of each of the following functions.
</p>
</introduction>

<task>
    <statement>
        <p>
        <m>f(x)=x^n</m>, where <m>n</m> is a positive integer
        </p>
    </statement>
<solution>
    <p>
        all real numbers or <m>(-\infty,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(x)=x^2+x+\frac{2}{x}</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers <m>x\neq0</m> or <m>(-\infty,0)\cup(0,\infty)</m> in interval notation
    </p>
</solution>
</task>

<task>
    <statement>
        <p>
        <m>f(x)=\frac{1}{\sqrt{x}}</m>
        </p>
    </statement>
<solution>
    <p>
        all real numbers <m>x\gt 0</m> or <m>(0,\infty)</m> in interval notation
    </p>
</solution>
</task>
</exercise>














</exercises>