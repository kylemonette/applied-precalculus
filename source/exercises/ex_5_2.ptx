<exercise>
<statement>
<p>
Find a formula in the form <m>y=A\cdot b^t</m> for the exponential function whose graph is given below:
</p>

<image width="50%" xml:id="ex_5_2_10">
<latex-image label="ex_5_2_10_fig">
\begin{tikzpicture}[scale=0.8]
\begin{axis}[grid=none,
xmin=0,xmax=5,
ymin=0,ymax=30,
xtick={0,1,2,3,4,5},
ytick={0,5,10,15,20,25,30},
minor tick={},
xlabel={$t$}, ylabel={$y$},
x post scale = 1.2,
]
\addplot[domain=0:5] {10*1.2^x};
\node[rpoint with label={-45:{$(2,14.4)$}}] at (axis cs:2,14.4) {};
\end{axis}
\end{tikzpicture}
</latex-image>
</image>
</statement>

<solution>
<p>
<m>y=10(1.2)^t</m>
</p>
</solution>
</exercise>




<exercise>
<statement>
<p>
Find a formula in the form <m>y=A\cdot b^t</m> for the exponential function whose graph is given below:
</p>

<image width="50%" xml:id="ex_5_2_11">
<latex-image label="ex_5_2_11_fig">
\begin{tikzpicture}[scale=0.8]
\begin{axis}[grid=none,
xmin=0,xmax=5,
ymin=0,ymax=240,
xtick={0,1,2,3,4,5},
