            \begin{tikzpicture}[scale=0.7]
            \begin{axis}[grid=none,
            xmin=-0.5, xmax=4,
            ymin=0, ymax=6,
            xtick={0,1,2,3,4},
            ytick={1,...,6},
            minor tick={},
            xlabel={$t$}, ylabel={$y$}
            ]
            \addplot[domain=0:4] {1.5*1.5^x};
            \node[rpoint with label={0:{}}] at (axis cs:0,1.5) {};
            \end{axis}
            \end{tikzpicture}
            </latex-image>
            </image>
            </p>
        </statement>
    </choice>

</choices>
</exercise>




<exercise>
<statement>
<p>
Which of the graphs below could be a graph of the function <m>y=0.8(0.75)^t</m>? Explain your answer!
</p>
</statement>

<choices>
    <choice>
        <statement>
            <p>
