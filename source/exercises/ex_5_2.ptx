<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_5_2">


<exercise>
<statement>
<p>
Complete the table of values below and use it to graph the exponential function <m>\displaystyle y=3^x</m> in the interval <m>-3\leq x \leq 3</m>.
</p>

<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>x</m></cell>
<cell><m>-3</m></cell>
<cell><m>-2</m></cell>
<cell><m>-1</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
</row>
<row>
<cell><m>y=3^x</m></cell>
<cell><m>\frac{1}{27}</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
</row>
</tabular>
</statement>

<solution>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>x</m></cell>
<cell><m>-3</m></cell>
<cell><m>-2</m></cell>
<cell><m>-1</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
</row>
<row>
<cell><m>y=3^x</m></cell>
<cell><m>\frac{1}{27}</m></cell>
<cell><m>\frac{1}{9}</m></cell>
<cell><m>\frac{1}{3}</m></cell>
<cell><m>1</m></cell>
<cell><m>3</m></cell>
<cell><m>9</m></cell>
<cell><m>27</m></cell>
</row>
</tabular>
</solution>
</exercise>




<exercise>
<statement>
<p>
Complete the table of values below and use it to graph the exponential function <m>\displaystyle y=\left(\frac{1}{3}\right)^x</m> in the interval <m>-3\leq x \leq 3</m>.
</p>

<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>x</m></cell>
<cell><m>-3</m></cell>
<cell><m>-2</m></cell>
<cell><m>-1</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
</row>
<row>
<cell><m>y=\left(\frac{1}{3}\right)^x</m></cell>
<cell><m>27</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
<cell><m>?</m></cell>
</row>
</tabular>
</statement>

<solution>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>x</m></cell>
<cell><m>-3</m></cell>
<cell><m>-2</m></cell>
<cell><m>-1</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
</row>
<row>
<cell><m>y=\left(\frac{1}{3}\right)^x</m></cell>
<cell><m>27</m></cell>
<cell><m>9</m></cell>
<cell><m>3</m></cell>
<cell><m>1</m></cell>
<cell><m>\frac{1}{3}</m></cell>
<cell><m>\frac{1}{9}</m></cell>
<cell><m>\frac{1}{27}</m></cell>
</row>
</tabular>
</solution>
</exercise>




<exercise>
<statement>
<p>
Below you see a graph of an exponential function <m>y=A\cdot b^t</m>. What is its initial value <m>A</m>? Is its growth factor <m>b</m> greater than <m>1</m> or less than <m>1</m>?
</p>

<image width="50%" xml:id="ex_5_2_1">
<latex-image label="ex_5_2_1_fig">
\begin{tikzpicture}[scale=0.8]
\begin{axis}[grid=none,
xmin=-0.5,xmax=5,
ymin=0,ymax=120,
xtick={0,1,2,3,4,5},
ytick={0,20,40,60,80,100,120},
minor tick={},
xlabel={$t$}, ylabel={$y$},
]
\addplot[domain=0:5] {100*0.5^x};
\node[rpoint with label={0:{}}] at (axis cs:0,100) {};
\end{axis}
\end{tikzpicture}
</latex-image>
</image>
</statement>

<solution>
<p>
<m>A=100</m>; <m>b\lt 1</m>
</p>
</solution>
</exercise>




<exercise>
<statement>
<p>
Which of the graphs below could be a graph of the function <m>y=3(1.5)^t</m>? Explain your answer!
</p>
</statement>

<choices>
    <choice>
        <statement>
            <p>
            <image width="40%" xml:id="ex_5_2_2">
            <latex-image label="ex_5_2_2_fig">
            \begin{tikzpicture}[scale=0.7]
            \begin{axis}[grid=none,
            xmin=-0.5, xmax=4,
            ymin=0, ymax=5,
            xtick={0,1,2,3,4},
            ytick={1,...,5},
            minor tick={},
            xlabel={$t$}, ylabel={$y$}
            ]
            \addplot[domain=0:4] {1.5*0.5^x};
            \node[rpoint with label={0:{}}] at (axis cs:0,1.5) {};
            \end{axis}
            \end{tikzpicture}
            </latex-image>
            </image>
            </p>
        </statement>
    </choice>

    <choice>
        <statement>
            <p>
            <image width="40%" xml:id="ex_5_2_3">
            <latex-image label="ex_5_2_3_fig">
            \begin{tikzpicture}[scale=0.7]
            \begin{axis}[grid=none,
            xmin=-0.5, xmax=4,
            ymin=0, ymax=5,
            xtick={0,1,2,3,4},
            ytick={1,...,5},
            minor tick={},
            xlabel={$t$}, ylabel={$y$}
            ]
            \addplot[domain=0:4] {3*0.5^x};
            \node[rpoint with label={0:{}}] at (axis cs:0,3) {};
            \end{axis}
            \end{tikzpicture}
            </latex-image>
            </image>
            </p>
        </statement>
    </choice>

    <choice correct="yes">
        <statement>
            <p>
            <image width="40%" xml:id="ex_5_2_4">
            <latex-image label="ex_5_2_4_fig">
            \begin{tikzpicture}[scale=0.7]
            \begin{axis}[grid=none,
            xmin=-0.5, xmax=4,
            ymin=0, ymax=6,
            xtick={0,1,2,3,4},
            ytick={1,...,6},
            minor tick={},
            xlabel={$t$}, ylabel={$y$}
            ]
            \addplot[domain=0:4] {3*1.5^x};
            \node[rpoint with label={0:{}}] at (axis cs:0,3) {};
            \end{axis}
            \end{tikzpicture}
            </latex-image>
            </image>
            </p>
        </statement>
    </choice>

    <choice>
        <statement>
