<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_3_3">

<exercisegroup>
<title>Vertex</title>
<introduction>
<p>
For each of the following, identify the vertex of the given quadratic function.
</p>
</introduction>

<exercise xml:id="exercise_3_3_1">
<statement>
<p>
<m>f(x)=-2(x-3)^2+4</m>
</p>
</statement>

<solution>
<p>
<m>(3,4)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_2">
<statement>
<p>
<m>y=5(x+2)^2-3</m>
</p>
</statement>

<solution>
<p>
<m>(-2,-3)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_3">
<statement>
<p>
<m>g(t)=2(t-1)^2-7</m>
</p>
</statement>

<solution>
<p>
<m>(1,-7)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_4">
<statement>
<p>
<m>h(x)=-(x+\frac{1}{2})^2+\frac{5}{3}</m>
</p>
</statement>

<solution>
<p>
<m>\left(-\frac{1}{2},\frac{5}{3}\right)</m>
</p>
</solution>
</exercise>

</exercisegroup>





<exercisegroup>
<title>Vertex Form to Standard Form</title>
<introduction>
<p>
Convert each quadratic function from vertex form to standard form and identify <m>a</m>, <m>b</m>, and <m>c</m>.
</p>
</introduction>



<exercise xml:id="exercise_3_3_5">
<statement>
<p>
<m>f(x)=(x+1)^2+2</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=x^2+2x+3</m>; <m>a=1</m>, <m>b=2</m>, <m>c=3</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_6">
<statement>
<p>
<m>g(x)=5(x-2)^2+6</m>
</p>
</statement>

<solution>
<p>
<m>g(x)=5x^2-20x+26</m>; <m>a=5</m>, <m>b=-20</m>, <m>c=26</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_7">
<statement>
<p>
<m>y=-2(t-4)^2+5</m>
</p>
</statement>

<solution>
<p>
<m>y=-2t^2+16t-27</m>; <m>a=-2</m>, <m>b=16</m>, <m>c=-27</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_8">
<statement>
<p>
<m>h(x)=-(x+\frac{1}{2})^2+\frac{5}{3}</m>
</p>
</statement>

<solution>
<p>
<m>h(x)=-x^2-x+\frac{17}{12}</m>; <m>a=-1</m>, <m>b=-1</m>, <m>c=\frac{17}{12}</m>
</p>
</solution>
</exercise>

</exercisegroup>



<exercisegroup>
<title>Standard Form to Vertex Form</title>
<introduction>
<p>
Convert each quadratic function from standard form to vertex form by completing the square. Then identify the vertex.
</p>
</introduction>


<exercise xml:id="exercise_3_3_9">
<statement>
<p>
<m>f(x)=x^2+2 x-5</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=(x+1)^2-6</m>; vertex: <m>(-1,-6)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_10">
<statement>
<p>
<m>g(x)=x^2-6 x+10</m>
</p>
</statement>

<solution>
<p>
<m>g(x)=\left(x-3\right)^2+1</m>; vertex <m>(3,1)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_11">
<statement>
<p>
<m>h(x)=x^2+3x+\frac{5}{4}</m>
</p>
</statement>

<solution>
<p>
<m>h(x)=\left(x+\frac{3}{2}\right)^2-1</m>; vertex <m>\left(-\frac{3}{2},-1\right)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_12">
<statement>
<p>
<m>F(x)=-x^2+10 x+15</m>
</p>
</statement>

<solution>
<p>
<m>F(x)=-\left(x-5\right)^2+40</m>; vertex <m>(5,40)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_13">
<statement>
<p>
<m>G(x)=-3 x^2+6 x-4</m>
</p>
</statement>

<solution>
<p>
<m>G(x)=-3(x-1)^2-1</m>; vertex <m>(1,-1)</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_14">
<statement>
<p>
<m>H(x)=-2 x^2-16 x-17</m>
</p>
</statement>

<solution>
<p>
<m>H(x)=-2\left(x+4\right)^2+15</m>; vertex <m>(-4,15)</m>
</p>
</solution>
</exercise>

</exercisegroup>



<exercisegroup>
<title>Horizontal Intercepts</title>
<introduction>
<p>
Find the horizontal intercepts of each quadratic function. Give exact and approximate values rounded off to three decimal places.
</p>
</introduction>


<exercise xml:id="exercise_3_3_15">
<statement>
<p>
<m>f(x)=(x+3)^2-16</m>
</p>
</statement>

<solution>
<p>
<m>-7</m>, <m>1</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_16">
<statement>
<p>
<m>g(x)=(x-1)^2-2</m>
</p>
</statement>

<solution>
<p>
<m>1-\sqrt{2}\approx-0.414</m>, <m>1+\sqrt{2}\approx2.414</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_17">
<statement>
<p>
<m>h(x)=(x-\frac{1}{2})^2-1</m>
</p>
</statement>

<solution>
<p>
<m>-0.5</m>, <m>1.5</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_18">
<statement>
<p>
<m>F(x)=x^2+4x-6</m>
</p>
</statement>

<solution>
<p>
<m>-2-\sqrt{10}\approx-5.162</m>, <m>-2+\sqrt{10}\approx1.162</m>
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_19">
<statement>
<p>
<m>G(x)=2x^2-3x+4</m>
</p>
</statement>

<solution>
<p>
No real solutions.
</p>
</solution>
</exercise>



<exercise xml:id="exercise_3_3_20">
<statement>
<p>

<m>H(x)=-2 x^2-16 x-27</m>
</p>
</statement>

<solution>
<p>
<m>-4-\sqrt{\frac{5}{2}}\approx-5.581</m>, <m>-4+\sqrt{\frac{5}{2}}\approx-2.419</m>
</p>
</solution>
</exercise>


</exercisegroup>



</exercises>