<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_5_3">


<exercisegroup>
<title>Exponential Functions</title>
<introduction>
<p>
For each of the following data tables, check if the data can possibly correspond to an exponential function or not. If yes, give a formula for the function in the form <m>A\cdot b^t</m>. Identify the initial value and the growth factor.
</p>
</introduction>

<exercise xml:id="exercise-5_3_1">
<statement>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
<cell><m>4</m></cell>
<cell><m>5</m></cell>
</row>
<row>
<cell><m>f(t)</m></cell>
<cell><m>5000</m></cell>
<cell><m>4000</m></cell>
<cell><m>3200</m></cell>
<cell><m>2560</m></cell>
<cell><m>2048</m></cell>
<cell><m>1638.4</m></cell>
</row>
</tabular>
</statement>

<solution>
<p>
possible exponential function; <m>f(t)=5000(0.8)^t</m>; initial value: <m>5000</m>; growth factor: <m>0.8</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
<cell><m>4</m></cell>
<cell><m>5</m></cell>
</row>
<row>
<cell><m>g(t)</m></cell>
<cell><m>32</m></cell>
<cell><m>48</m></cell>
<cell><m>72</m></cell>
<cell><m>108</m></cell>
<cell><m>162</m></cell>
<cell><m>243</m></cell>
</row>
</tabular>
</statement>

<solution>
<p>
possible exponential function; <m>g(t)=32(1.5)^t</m>; initial value: <m>32</m>; growth factor: <m>1.5</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
<cell><m>4</m></cell>
<cell><m>5</m></cell>
</row>
<row>
<cell><m>k(t)</m></cell>
<cell><m>64</m></cell>
<cell><m>32</m></cell>
<cell><m>16</m></cell>
<cell><m>8</m></cell>
<cell><m>0</m></cell>
<cell><m>2</m></cell>
</row>
</tabular>
</statement>

<solution>
<p>
not an exponential function
</p>
</solution>
</exercise>


<exercise>
<statement>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>1</m></cell>
<cell><m>2</m></cell>
<cell><m>3</m></cell>
<cell><m>4</m></cell>
<cell><m>5</m></cell>
</row>
<row>
<cell><m>h(t)</m></cell>
<cell><m>1280</m></cell>
<cell><m>1600</m></cell>
<cell><m>2000</m></cell>
<cell><m>2500</m></cell>
<cell><m>3125</m></cell>
</row>
</tabular>
</statement>

<solution>
<p>
possible exponential function; <m>h(t)=1024(1.25)^t</m>; initial value: <m>1024</m>; growth factor: <m>1.25</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise-5_3_5">
<statement>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>0</m></cell>
<cell><m>1</m></cell>
