<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_4_4">


<exercisegroup>
<title>Power Functions</title>
<introduction>
<p>
Determine whether the given function is a power function. If yes, identify the coefficient <m>k</m> and the exponent <m>p</m>. If not, say so.
</p>
</introduction>


<exercise xml:id="exercise_4_4_1">
<statement>
<p>
<m>\displaystyle y= \frac{\sqrt{x^3}}{0.1x}</m>
</p>
</statement>

<solution>
<p>
<m>y=10x^{1/2}</m>; <m>k=10</m>; <m>p=\frac{1}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_4_4_2">
<statement>
<p>
<m>\displaystyle y= \frac{\sqrt{0.01x^3}}{\sqrt{x}}</m>
</p>
</statement>

<solution>
<p>
<m>y=0.1x</m>; <m>k=0.1</m>; <m>p=1</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_4_4_3">
<statement>
<p>
<m>\displaystyle g(x)=\frac{x^{\frac{5}{3}}}{4x^{\frac{1}{4}}}</m>
</p>
</statement>

<solution>
<p>
<m>y=\frac{1}{4}x^{17/12}</m>; <m>k=\frac{1}{4}</m>; <m>p=\frac{17}{12}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_4_4_4">
<statement>
<p>
<m>\displaystyle h(x)=2x^{\frac{3}{2}}-x^{-2}</m>
</p>
</statement>

<solution>
<p>
Not a power function.
</p>
</solution>
</exercise>


<exercise xml:id="exercise_4_4_5">
<statement>
<p>
<m>\displaystyle y=\sqrt{\frac{x^5}{9x}}</m>
</p>
</statement>

<solution>
<p>
<m>y=\frac{1}{3}x^2</m>; <m>k=\frac{1}{3}</m>; <m>p=2</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_4_4_6">
<statement>
<p>
<m>\displaystyle f(x)=(\sqrt{2^x})^2</m>
</p>
</statement>

<solution>
<p>
Not a power function.
</p>
</solution>
</exercise>

</exercisegroup>





<exercise xml:id="exercise_4_4_7">
<statement>
<p>
Four power functions <m>y=kx^p</m> are graphed below, where <m>p</m> is a negative integer. In each of the graphs, is the exponent <m>p</m> even or odd? Is the coefficient <m>k</m> positive or negative?
</p>

<sidebyside widths="24% 24% 24% 24%" margins="0% 0%" valigns="bottom bottom bottom bottom">

<image width="50%" xml:id="ex_4_4_1">
<shortdescription>
A short description.
</shortdescription>
<latex-image label="ex_4_4_1_fig">
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-2.5:-0.1] {1/x};
\addplot[domain=0.1:2.5] {1/x};
\end{axis}
\end{tikzpicture}
</latex-image>
</image>

<image width="50%" xml:id="ex_4_4_2">
<shortdescription>
A short description.
</shortdescription>
<latex-image label="ex_4_4_2_fig">
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-3:-0.5] {-1/x^2};
\addplot[domain=0.5:3] {-1/x^2};
\end{axis}
\end{tikzpicture}
</latex-image>
</image>

<image width="50%" xml:id="ex_4_4_3">
<shortdescription>
A short description.
</shortdescription>
<latex-image label="ex_4_4_3_fig">
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-2.5:-0.1] {-1/x};
\addplot[domain=0.1:2.5] {-1/x};
\end{axis}
\end{tikzpicture}
</latex-image>
</image>

<image width="50%" xml:id="ex_4_4_4">
<shortdescription>
A short description.
</shortdescription>
<latex-image label="ex_4_4_4_fig">
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-3:-0.5] {1/x^2};
\addplot[domain=0.5:3] {1/x^2};
\end{axis}
\end{tikzpicture} 
</latex-image>
</image>

</sidebyside>
</statement>

<solution>
<p>
From left to right:
</p>

<p>
<ul>
<li><m>p</m> is odd; <m>k</m> is positive.</li>
<li><m>p</m> is even; <m>k</m> is negative.</li>
<li><m>p</m> is odd; <m>k</m> is negative.</li>
<li><m>p</m> is even; <m>k</m> is positive.</li>
</ul>
</p>
</solution>
</exercise>


