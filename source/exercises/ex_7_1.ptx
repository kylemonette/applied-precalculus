<exercise xml:id="exercise-7_1_20">
<statement>
<p>
<m>y=f(t+3.1)+1.1</m>
</p>
</statement>

<solution>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>t</m></cell>
<cell><m>-3.1</m></cell>
<cell><m>1.9</m></cell>
