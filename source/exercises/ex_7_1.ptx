<cell><m>-3</m></cell>
<cell><m>2</m></cell>
<cell><m>7</m></cell>
<cell><m>12</m></cell>
</row>

<row>
<cell><m>y</m></cell>
<cell><m>0.1</m></cell>
<cell><m>0.2</m></cell>
<cell><m>0.4</m></cell>
<cell><m>0.8</m></cell>
</row>
</tabular>
</solution>
</exercise>


<exercise xml:id="exercise_7_1_18">
<statement>
<p>
<m>y=f(t)-2</m>
</p>
</statement>

<solution>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
