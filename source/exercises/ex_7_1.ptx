</tabular>
</solution>
</exercise>


<exercise xml:id="exercise_7_1_19">
<statement>
<p>
<m>y=f(t-2)+6</m>
</p>
</statement>

<solution>
<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
