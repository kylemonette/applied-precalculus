<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_1_4">

<exercise>
<statement>
<p>
Find the horizontal and vertical intercepts or state that they don't exist for each function given below.
</p>
<ol>
<li><m>y=3x-1.5</m></li>
<li><m>f(x)=1-x^2</m></li>
<li><m>g(t)=5.4-0.2t</m></li>
<li><m>y=2x^3+16</m></li>
<li><m>h(m)=2\sqrt{m}-3</m></li>
<li><m> y=\dfrac{1}{x}</m></li>
<li><m>y=\dfrac{1}{x-1}</m></li>
</ol>
</statement>

<solution>
<p>
    <ol>
        <li>
            <alert>horizontal intercept:</alert> <m>0.5</m>; <alert>vertical intercept:</alert> <m>-1.5</m>
        </li>
        <li>
            <alert>horizontal intercepts:</alert> <m>-1</m>, <m>1</m>; <alert>vertical intercept:</alert> <m>1</m>
        </li>
        <li>
            <alert>horizontal intercept:</alert> <m>27</m>; <alert>vertical intercept:</alert> <m>5.4</m>
        </li>
        <li>
            <alert>horizontal intercept:</alert> <m>-2</m>; <alert>vertical intercept:</alert> <m>16</m>
        </li>
        <li>
            <alert>horizontal intercept:</alert> <m>9/4</m>; <alert>vertical intercept:</alert> <m>-3</m>
        </li>
        <li>
            <alert>horizontal intercepts:</alert> none; <alert>vertical intercept:</alert> none
        </li>
        <li>
            <alert>horizontal intercept:</alert> none; <alert>vertical intercept:</alert> <m>-1</m>
        </li>
    </ol>
</p>
</solution>
</exercise>






<exercise>
<statement>
<p>
Identify the horizontal and vertical intercepts for each function given numerically below.
</p>
<ol>
<li>

<tabular left="minor" right="minor" top="minor" bottom="minor" halign="center">
<row bottom="minor">
<cell><m>x</m></cell>
