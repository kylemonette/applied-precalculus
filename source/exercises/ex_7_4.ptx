<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_7_4">


<exercisegroup>
<title>Identifying Inverse Functions</title>
<introduction>
<p>
For each of the following, find <m>f(g(x))</m> and <m>g(f(x))</m> for the pair of functions <m>f(x)</m> and <m>g(x)</m> given. Use your results to determine whether <m>f(x)</m> and <m>g(x)</m> are inverses of each other.
</p>
</introduction>

<exercise xml:id="exercise-7_4_1">
<statement>
<p>
<m>f(x)=x^2</m> and <m>g(x)=\sqrt{x}</m>
</p>
</statement>

<solution>
<p>
Not inverses.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=4x</m> and <m>g(x)=\dfrac{4}{x}</m>
</p>
</statement>

<solution>
<p>
Not inverses.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=2x+5</m> and <m>g(x)=\dfrac{x-5}{2}</m>
</p>
</statement>

<solution>
<p>
Inverses.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=3x-1</m> and <m>g(x)=\frac{1}{3}x+1</m>
</p>
</statement>

<solution>
<p>
Not Inverses.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=\sqrt[3]{x-2}</m> and <m>g(x)=x^3+2</m>
</p>
</statement>

<solution>
<p>
Inverses.
</p>
</solution>
</exercise>


<exercise xml:id="exercise-7_4_6">
<statement>
<p>
<m>f(x)=\dfrac{3}{x-4}</m> and <m>g(x)=\dfrac{3}{x}+4</m>
</p>
</statement>

<solution>
<p>
Inverses.
</p>
</solution>
</exercise>

</exercisegroup>



<exercisegroup>
<title>Computing an Inverse Function</title>
<introduction>
<p>
For each of the following, find the inverse of each function, if possible. If not possible, state this to be the case.
</p>
</introduction>

<exercise xml:id="exercise-7_4_7">
<statement>
<p>
<m>f(x)=5x</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\frac{x}{5}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(t)=\dfrac{2}{t}</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(t)=\frac{2}{t}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=3-\frac{1}{2}x</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=-2x+6</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(w)=5x^2</m>
</p>
</statement>

<solution>
<p>
No inverse function.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=10-3x^3</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\sqrt[3]{\dfrac{10-x}{3}}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=\sqrt[3]{x+1}</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=x^3-1</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=4(x+1)^2-7</m>
</p>
</statement>

<solution>
<p>
No inverse function.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=\dfrac{1}{3x-1}</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\dfrac{x+1}{3x}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=\dfrac{2x-5}{3x+1}</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\dfrac{-x-5}{3x-2}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=2^x</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\log_2(x)=\dfrac{\log(x)}{\log(2)}=\dfrac{\ln(x)}{\ln(2)}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=5e^x-6</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\ln\left(\dfrac{x+6}{5}\right)</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>f(x)=\ln(x+1)</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=e^x-1</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise-7_4_19">
<statement>
<p>
<m>f(x)=\frac{1}{2}\log_6(x)-10</m>
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=6^{2x+20}</m>
</p>
</solution>
</exercise>

</exercisegroup>



<exercise>
<statement>
<p>
The function <m>f(x)=\frac{9}{5}x+32</m> is used to convert an input <m>x</m> in degrees Celsius to an output <m>f(x)</m> in degrees Fahrenheit. Find the inverse function, which is the formula used to convert an input in degrees Fahrenheit to an output in degrees Celsius.
</p>
</statement>

<solution>
<p>
<m>f^{-1}(x)=\frac{5}{9}x-\frac{160}{9}</m>
</p>
</solution>
</exercise>

</exercises>
