<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_8_3">


<exercisegroup>
<title>Evaluating Sine and Cosine</title>
<introduction>
<p>
For each of the following, find the exact value without using a calculator.
</p>
</introduction>

<exercise xml:id="exercise-8_3_1">
<statement>
<p>
<m>\sin\left(\frac{5\pi}{4}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{\sqrt{2}}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_2">
<statement>
<p>
<m>\cos\left(\frac{5\pi}{4}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{\sqrt{2}}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_3">
<statement>
<p>
<m>\cos\left(\frac{2\pi}{3}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{1}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_4">
<statement>
<p>
<m>\sin\left(\frac{2\pi}{3}\right)</m>
</p>
</statement>

<solution>
<p>
<m>\frac{\sqrt{3}}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_5">
<statement>
<p>
<m>\sin\left(-90^{\circ}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-1</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_6">
<statement>
<p>
<m>\cos\left(-2\pi\right)</m>
</p>
</statement>

<solution>
<p>
<m>1</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_7">
<statement>
<p>
<m>\cos\left(-\frac{\pi}{6}\right)</m>
</p>
</statement>

<solution>
<p>
<m>\frac{\sqrt{3}}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_8">
<statement>
<p>
<m>\sin\left(-\frac{\pi}{6}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{1}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise_8_3_9">
<statement>
<p>
<m>\sin\left(240^{\circ}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{\sqrt{3}}{2}</m>
</p>
</solution>
</exercise>


<exercise xml:id="exercise-8_3_10">
<statement>
<p>
<m>\cos\left(240^{\circ}\right)</m>
</p>
</statement>

<solution>
<p>
<m>-\frac{1}{2}</m>
</p>
</solution>
</exercise>

</exercisegroup>


</exercises>
