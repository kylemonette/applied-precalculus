<?xml version="1.0" encoding="UTF-8"?>
<exercises xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ex_2_2">


<exercisegroup>
<title>Slope-Intercept Form</title>
<introduction>
<p>
    For each of the following, write the equation of the line satisfying the given set of conditions in slope-intercept form.
</p>
</introduction>


<exercise>
<statement>
<p>
passing through <m>(2,6)</m> and <m>(1,8)</m>
</p>
</statement>

<solution>
<p>
<m>y=-2x+10</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
passing through <m>(-4,7)</m> and <m>(-10,-8)</m>
</p>
</statement>

<solution>
<p>
<m>y=\frac{5}{2}x+17</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
with slope <m>2.1</m> passing through <m>(0.1,0)</m>
</p>
</statement>

<solution>
<p>
<m>y=2.1x-0.21</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
with slope <m>6</m> passing through <m>(-5,2)</m>
</p>
</statement>

<solution>
<p>
<m>y=6x+32</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
with slope <m>-\frac{1}{2}</m> passing through <m>(\frac{2}{5},-1)</m>
</p>
</statement>

<solution>
<p>
<m>y=-\frac{1}{2}x-\frac{4}{5}</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
passing through <m>(1,3)</m> and <m>(-7,3)</m>
</p>
</statement>

<solution>
<p>
<m>y=3</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
passing through <m>(5,-5)</m> and <m>(5,2)</m>
</p>
</statement>

<solution>
<p>
<m>x=5</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
with slope 0 and passing through <m>(-3,-1)</m>
</p>
</statement>

<solution>
<p>
<m>y=-1</m>
</p>
</solution>
</exercise>

</exercisegroup>



<exercisegroup>
<title>Slope-Intercept Form</title>
    <introduction>
        <p>
           For each of the following, write the formula in slope-intercept form for the linear function <m>f(x)</m> satisfying the given set of conditions.
        </p>
    </introduction>

<exercise>
<statement>
<p>
<m>f(2)=-5</m> and <m>f(4)=0</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=\frac{5}{2}x-10</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>f(1)=-2</m> and <m>f(3)=-5</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=-\frac{3}{2}x-\frac{1}{2}</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>f(x)</m> has slope <m>2.1</m> and its graph passes through <m>(0.1,0)</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=2.1x-0.21</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>f(x)</m> has slope <m>-1</m> and its graph passes through <m>(-1,2)</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=-x+1</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
the graph of <m>f(x)</m> passes through <m>(-1,3)</m> and <m>(-7,-2)</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=\frac{5}{6}x+\frac{23}{6}</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
the slope of <m>f(x)</m> is 3 and its horizontal intercept is <m>-2</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=3x+6</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
the slope of <m>f(x)</m> is 1 and its vertical intercept is <m>2</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=x+2</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
the vertical intercept of <m>f(x)</m> is <m>3</m> and its horizontal intercept is <m>7</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=-\frac{3}{7}x+3</m>
</p>
</solution>
</exercise>

</exercisegroup>




<exercise>
<statement>
<p>
Which of the following lines is NOT the graph of a linear function?
</p>
<ol>
<li><m>y=-2x-3x+1</m></li>
<li><m>y=-5</m></li>
<li><m>x=7</m></li>
</ol>
</statement>

<solution>
<p>
(c) is not the graph of a linear function.
</p>
</solution>
</exercise>





<exercise>
<statement>
<p>
The distance in miles from the finish line, <m>D(t)</m>, of a bicyclist <m>t</m> hours after beginning a race is given by <m>D(t)=60-20t</m>
</p>
<ol>
<li>Write a complete sentence explaining the practical meaning of the vertical intercept of this linear function. Include units in your answer.</li>
<li>Write a complete sentence explaining the practical meaning of the horizontal intercept of this linear function. Include units in your answer.</li>
<li>Write a complete sentence explaining the practical meaning of the slope of this linear function. Include units in your answer.</li>
</ol>
</statement>

<solution>
<p>
    <ol>
        <li>
            <p>The vertical intercept 60 is the distance in miles that the biker is from the finish line at the start of the race.</p>
        </li>
        <li>
            The horizontal intercept 3 is the number of hours that it takes the biker to complete the race.
        </li>
        <li>
            <p>The slope <m>-20</m> indicates that the distance between the biker and the finish line is decreasing at a rate of 20 miles per hour.</p>
        </li>
    </ol>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
The value of an antique lamp, <m>V(t)</m>, in dollars, <m>t</m> years after its purchase is given by
<md>
V(t)=1900+250t.
</md>
</p>
<ol>
<li>What was the purchase price of the lamp?</li>
<li>When will the value of the lamp reach <m>\$4000</m>?</li>
</ol>
</statement>

<solution>
<p>
    <ol>
        <li>
            <m>\$1900</m>
        </li>
        <li>
            The lamp will have a value of 4000 dollars 8.4 years after its purchase.
        </li>
    </ol>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
Two mobile phone companies sell an international roaming plan. Company A charges a <m>\$75</m> dollar fixed monthly fee and <m>\$0.20</m> per minute for talk. Company B charges a <m>\$90</m> dollar fixed monthly fee and <m>\$0.10</m> per minute for talk.
</p>
<ol>
<li>Write the linear functions <m>A(m)</m> and <m>B(m)</m> which give the monthly cost charged by Company A and Company B, respectively, with <m>m</m> minutes spent talking on the phone.</li>
<li>For what value of <m>m</m> is the cost the same with either company?</li>
<li>Which company gives you a better deal if you plan to talk for hours?</li>
</ol>
</statement>

<solution>
<p>
    <ol>
        <li>
            <m>A(m)=0.20m+75</m>; <m>B(m)=0.10m+90</m>
        </li>
        <li>
            <m>m=150</m>
        </li>
        <li>
            <m>B(m)</m>
        </li>
    </ol>
</p>
</solution>
</exercise>






<exercisegroup>
<title>Solving Linear Equations</title>
    <introduction>
        <p>
           Solve each linear equation. If there is no solution or infinitely many solutions, say so.
        </p>
    </introduction>


<exercise>
<statement>
<p>
<m>0.1x-(2x-5)=2.5</m>
</p>
</statement>

<solution>
<p>
<m>x\approx1.3158</m>
</p>
</solution>
</exercise>




<exercise>
<statement>
<p>
<m>\dfrac{-2(x-3)}{5}=x+1</m>
</p>
</statement>

<solution>
<p>
<m>x=\frac{1}{7}</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>3x-7=5+3x</m>
</p>
</statement>

<solution>
<p>
no solution
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>2x+2=4+2(x-1)</m>
</p>
</statement>

<solution>
<p>
infinite number of solutions
</p>
</solution>
</exercise>

</exercisegroup>

</exercises>