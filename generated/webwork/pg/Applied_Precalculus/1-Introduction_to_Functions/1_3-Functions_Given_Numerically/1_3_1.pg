
DOCUMENT(); 

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "MathObjects.pl",
  "PGcourse.pl",
  "PGML.pl",
  "niceTables.pl"
);

TEXT(beginproblem());

Context("Numeric")->flags->set(tolerance => 0.0000001, tolType => "absolute");


@y = (-10,-5,0,5,10);
@perm = shuffle(5);
@inv = invert(@perm);
@gy = @y[@perm];

$i = 2+non_zero_random(-2,2,1);

# avoid fixed points
while ($y[2]==$gy[2] || $y[$i]==$gy[$i]) {
  @perm = shuffle(5);
  @inv = invert(@perm);
  @gy = @y[@perm];
}

$answera = List($y[$perm[2]]);
$answerb = List($y[$perm[$i]]);
$answerc = List($y[$inv[2]]);
$answerd = List($y[$inv[$i]]);


$table = 
DataTable(
    [
        ["\(x\)", "\($y[0]\)", "\($y[1]\)", "\($y[2]\)", "\($y[3]\)", "\($y[4]\)"],
        ["\(g(x)\)", "\($gy[0]\)", "\($gy[1]\)", "\($gy[2]\)", "\($gy[3]\)", "\($gy[4]\)"]
    ],
    midrules => 1,
    align => "| c | c | c| c| c| c|"
);


BEGIN_PGML

The function [`g(x)`] is given by the following table of values.

[$table]***

Use the table to fill in the missing values.
Separate multiple answers with a comma.

a. [`g(0) =`] [__]{$answera}

b. [`g([$y[$i]]) = `] [__]{$answerb}

c. [`g \big( `]  [__]{$answerc} [`\big) = 0`]

d. [`g \big( `]  [__]{$answerd} [` \big) = [$y[$i]] `]

END_PGML

ENDDOCUMENT();