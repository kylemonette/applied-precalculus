12 dict begin
/FontInfo 10 dict dup begin
/version (003.002) readonly def
/Notice (Copyright \(c\) 1997, 2009 American Mathematical Society \(<htt\
p://www.ams.org>\), with Reserved Font Name CMMI10.) readonly def
