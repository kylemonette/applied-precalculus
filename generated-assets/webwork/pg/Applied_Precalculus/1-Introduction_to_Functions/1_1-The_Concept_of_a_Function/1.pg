
DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());

Context()->variables->are(x => "Real");

$a = random(2,6,1);
$b = non_zero_random(-5,5,1);
$f = Formula("$a*x + $b")->reduce;

$x1 = random(1,3,1);
$x2 = random(-6,-1,0.5);
$x3 = 0;
$y1 = $f->eval(x=>$x1);
$y2 = $f->eval(x=>$x2);
$y3 = $f->eval(x=>$x3);

############################################################
# Body
############################################################

BEGIN_PGML

Let [`f(x) = [$f]`]. Evaluate:

a. [`f([$x1])`]

    [_]{$y1}

b. [`f([$x2])`]

    [_]{$y2}

c. [`f([$x3])`]

    [_]{$y3}

END_PGML

BEGIN_PGML_SOLUTION
a. [`f([$x1]) = [$y1] `]

b. [`f([$x2]) = [$y2] `]

c. [`f([$x3]) = [$y3] `]
END_PGML_SOLUTION

ENDDOCUMENT();