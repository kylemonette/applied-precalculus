
In \exrange{exercise-3.3.1}{exercise-3.3.4}, identify the vertex of the given quadratic function.


<exercise>
<statement>
<p>
\label{exercise-3.3.1}
<m>f(x)=-2(x-3)^2+4</m>
</p>
</statement>

<solution>
<p>
<m>(3,4)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>y=5(x+2)^2-3</m>
</p>
</statement>

<solution>
<p>
<m>(-2,-3)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>g(t)=2(t-1)^2-7</m>
</p>
</statement>

<solution>
<p>
<m>(1,-7)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
\label{exercise-3.3.4}
<m>h(x)=-(x+\frac{1}{2})^2+\frac{5}{3}</m>
</p>
</statement>

<solution>
<p>
<m>\left(-\frac{1}{2},\frac{5}{3}\right)</m>
</p>
</solution>
</exercise>







\noindent In \exrange{exercise-3.3.5}{exercise-3.3.8}, convert each quadratic function from vertex form to standard form and identify <m>a</m>, <m>b</m>, and <m>c</m>.


<exercise>
<statement>
<p>
\label{exercise-3.3.5}
<m>f(x)=(x+1)^2+2</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=x^2+2x+3</m>; <m>a=1</m>, <m>b=2</m>, <m>c=3</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>g(x)=5(x-2)^2+6</m>
</p>
</statement>

<solution>
<p>
<m>g(x)=5x^2-20x+26</m>; <m>a=5</m>, <m>b=-20</m>, <m>c=26</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>y=-2(t-4)^2+5</m>
</p>
</statement>

<solution>
<p>
<m>y=-2t^2+16t-27</m>; <m>a=-2</m>, <m>b=16</m>, <m>c=-27</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
\label{exercise-3.3.8}
<m>h(x)=-(x+\frac{1}{2})^2+\frac{5}{3}</m>
</p>
</statement>

<solution>
<p>
<m>h(x)=-x^2-x+\frac{17}{12}</m>; <m>a=-1</m>, <m>b=-1</m>, <m>c=\frac{17}{12}</m>
</p>
</solution>
</exercise>








\noindent In \exrange{exercise-3.3.9}{exercise-3.3.14}, convert each quadratic function from standard form to vertex form by completing the square. Then identify the vertex.


<exercise>
<statement>
<p>
\label{exercise-3.3.9}
<m>f(x)=x^2+2 x-5</m>
</p>
</statement>

<solution>
<p>
<m>f(x)=(x+1)^2-6</m>; vertex: <m>(-1,-6)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>g(x)=x^2-6 x+10</m>
</p>
</statement>

<solution>
<p>
<m>g(x)=\left(x-3\right)^2+1</m>; vertex <m>(3,1)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>h(x)=x^2+3x+\frac{5}{4}</m>
</p>
</statement>

<solution>
<p>
<m>h(x)=\left(x+\frac{3}{2}\right)^2-1</m>; vertex <m>\left(-\frac{3}{2},-1\right)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>F(x)=-x^2+10 x+15</m>
</p>
</statement>

<solution>
<p>
<m>F(x)=-\left(x-5\right)^2+40</m>; vertex <m>(5,40)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>G(x)=-3 x^2+6 x-4</m>
</p>
</statement>

<solution>
<p>
<m>G(x)=-3(x-1)^2-1</m>; vertex <m>(1,-1)</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
\label{exercise-3.3.14}
<m>H(x)=-2 x^2-16 x-17</m>
</p>
</statement>

<solution>
<p>
<m>H(x)=-2\left(x+4\right)^2+15</m>; vertex <m>(-4,15)</m>
</p>
</solution>
</exercise>







\noindent In \exrange{exercise-3.3.15}{exercise-3.3.20}, find the horizontal intercepts of each quadratic function. Give exact and approximate values rounded off to three decimal places.


<exercise>
<statement>
<p>
\label{exercise-3.3.15}
<m>f(x)=(x+3)^2-16</m>
</p>
</statement>

<solution>
<p>
<m>-7</m>, <m>1</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>g(x)=(x-1)^2-2</m>
</p>
</statement>

<solution>
<p>
<m>1-\sqrt{2}\approx-0.414</m>, <m>1+\sqrt{2}\approx2.414</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>h(x)=(x-\frac{1}{2})^2-1</m>
</p>
</statement>

<solution>
<p>
<m>-0.5</m>, <m>1.5</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>F(x)=x^2+4x-6</m>
</p>
</statement>

<solution>
<p>
<m>-2-\sqrt{10}\approx-5.162</m>, <m>-2+\sqrt{10}\approx1.162</m>
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
<m>G(x)=2x^2-3x+4</m>
</p>
</statement>

<solution>
<p>
No real solutions.
</p>
</solution>
</exercise>



<exercise>
<statement>
<p>
\label{exercise-3.3.20}
<m>H(x)=-2 x^2-16 x-27</m>
</p>
</statement>

<solution>
<p>
<m>-4-\sqrt{\frac{5}{2}}\approx-5.581</m>, <m>-4+\sqrt{\frac{5}{2}}\approx-2.419</m>
</p>
</solution>
</exercise>
