

\noindent In \exrange{exercise-4.4.1}{exercise-4.4.6}, determine whether a given function is a power function. If yes, identify the coefficient <m>k</m> and the exponent <m>p</m>. If not, say so.

<exercise>
<statement>
<p>
\label{exercise-4.4.1}
<m>\displaystyle y= \frac{\sqrt{x^3}}{0.1x}</m>
</p>
</statement>

<solution>
<p>
<m>y=10x^{1/2}</m>; <m>k=10</m>; <m>p=\frac{1}{2}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>\displaystyle y= \frac{\sqrt{0.01x^3}}{\sqrt{x}}</m>
</p>
</statement>

<solution>
<p>
<m>y=0.1x</m>; <m>k=0.1</m>; <m>p=1</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>\displaystyle g(x)=\frac{x^{\frac{5}{3}}}{4x^{\frac{1}{4}}}</m>
</p>
</statement>

<solution>
<p>
<m>y=\frac{1}{4}x^{17/12}</m>; <m>k=\frac{1}{4}</m>; <m>p=\frac{17}{12}</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>\displaystyle h(x)=2x^{\frac{3}{2}}-x^{-2}</m>
</p>
</statement>

<solution>
<p>
Not a power function.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
<m>\displaystyle y=\sqrt{\frac{x^5}{9x}}</m>
</p>
</statement>

<solution>
<p>
<m>y=\frac{1}{3}x^2</m>; <m>k=\frac{1}{3}</m>; <m>p=2</m>
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
\label{exercise-4.4.6}
<m>\displaystyle f(x)=(\sqrt{2^x})^2</m>
</p>
</statement>

<solution>
<p>
Not a power function.
</p>
</solution>
</exercise>







<exercise>
<statement>
<p>
Four power functions <m>y=kx^p</m> are graphed below, where <m>p</m> is a negative integer. In each of the graphs, is the exponent <m>p</m> even or odd? Is the coefficient <m>k</m> positive or negative?

\noindent
\begin{tabular}{cccc}
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-2.5:-0.1] {1/x};
\addplot[domain=0.1:2.5] {1/x};
\end{axis}
\end{tikzpicture}
&
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-3:-0.5] {-1/x^2};
\addplot[domain=0.5:3] {-1/x^2};
\end{axis}
\end{tikzpicture}
&
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-2.5:-0.1] {-1/x};
\addplot[domain=0.1:2.5] {-1/x};
\end{axis}
\end{tikzpicture}
&
\begin{tikzpicture}[scale=0.5]
\begin{axis}[grid=none,
xmin=-3,xmax=3,
ymin=-3,ymax=3,
xtick=\empty,
ytick=\empty,
minor tick={},
xlabel={}, ylabel={},
]
\addplot[domain=-3:-0.5] {1/x^2};
\addplot[domain=0.5:3] {1/x^2};
\end{axis}
\end{tikzpicture} \\
(a) & (b) & (c) & (d)
\end{tabular}
</p>
</statement>

<solution>
<p>
(a) <m>p</m> is odd; <m>k</m> is positive.
(b) <m>p</m> is even; <m>k</m> is negative.
(c) <m>p</m> is odd; <m>k</m> is negative.
(d) <m>p</m> is even; <m>k</m> is positive.
</p>
</solution>
</exercise>


<exercise>
<statement>
<p>
Which of the following is a graph of <m>f(x)=-2x^{-5}</m>?

\begin{tabular}{ccc}
\begin{tikzpicture}[scale=0.5]
